# Copy to ~/.config/strata/boot.env and replace every path/account for the destination host.
# This file intentionally contains no API keys or tunnel credentials.
STRATA_SERVICE_USER=your-service-account
STRATA_START_SCRIPT=/absolute/path/to/llm-launchers/start-qwen38.sh
STRATA_STOP_SCRIPT=/absolute/path/to/llm-launchers/strata-stop.sh
STRATA_CORS_SCRIPT=/absolute/path/to/strata-cors-front.py
STRATA_CORS_TARGET=http://127.0.0.1:8080
STRATA_CORS_PORT=8086
STRATA_CORS_BIND=127.0.0.1
